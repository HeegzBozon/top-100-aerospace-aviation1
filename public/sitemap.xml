<?xml version="1.0" encoding="UTF-8"?>
<!--
  One entry point for crawlers, on the custom domain.

  Two children:
  - sitemap-pages.xml          the public marketing surfaces, maintained by hand.
  - functions/getProfileSitemap one URL per indexable Fellow profile, generated
                               from live data so it never goes stale.

  This file is an index rather than a list so there is a single URL to submit, while
  the profile set keeps updating itself without a rebuild.
-->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://top100aero.space/sitemap-pages.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://top100aero.space/functions/getProfileSitemap</loc>
  </sitemap>
</sitemapindex>
