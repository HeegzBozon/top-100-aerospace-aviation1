{
  "name": "StoryFragment",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner of this fragment"
    },
    "prompt_id": {
      "type": "string",
      "description": "ID of the prompt that generated this fragment"
    },
    "prompt_category": {
      "type": "string",
      "enum": [
        "foundations",
        "inflection_points",
        "impact",
        "leadership",
        "future_arc"
      ],
      "description": "Category of the prompt"
    },
    "prompt_text": {
      "type": "string",
      "description": "The original prompt question"
    },
    "content": {
      "type": "string",
      "description": "User's story response"
    },
    "timeline_era": {
      "type": "string",
      "enum": [
        "early_career",
        "transition",
        "breakthrough",
        "leadership",
        "future"
      ],
      "default": "early_career",
      "description": "Where this fits in timeline"
    },
    "timeline_order": {
      "type": "number",
      "default": 0,
      "description": "Order in timeline view"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "nominators",
        "public",
        "featured"
      ],
      "default": "private",
      "description": "Privacy level"
    },
    "impact_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Impact areas: innovation, leadership, community, etc."
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Locked fragments won't be regenerated"
    }
  },
  "required": [
    "user_email",
    "content"
  ]
}