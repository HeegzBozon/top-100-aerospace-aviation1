{
  "name": "MeritSnapshot",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "The user who earned the merit points"
    },
    "season_id": {
      "type": "string",
      "description": "The season during which the merit was earned"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date",
      "description": "The date the merit was recorded"
    },
    "metric_name": {
      "type": "string",
      "description": "The name of the metric being recorded, e.g., 'features_completed'"
    },
    "metric_value": {
      "type": "number",
      "description": "The value of the metric at the time of the snapshot"
    },
    "merit_points_awarded": {
      "type": "number",
      "description": "The number of merit points awarded for this achievement"
    }
  },
  "required": [
    "user_email",
    "season_id",
    "snapshot_date",
    "metric_name",
    "metric_value",
    "merit_points_awarded"
  ]
}