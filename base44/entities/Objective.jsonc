{
  "name": "Objective",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "ID of the Seasonal Plan this objective belongs to"
    },
    "name": {
      "type": "string",
      "description": "The high-level strategic goal to be achieved"
    },
    "description": {
      "type": "string",
      "description": "A detailed description of the objective"
    },
    "theme": {
      "type": "string",
      "description": "Strategic theme label for portfolio-level categorization"
    },
    "status": {
      "type": "string",
      "enum": [
        "funnel",
        "analyzing",
        "implementing",
        "done"
      ],
      "default": "funnel",
      "description": "Current state of the objective in the portfolio Kanban"
    },
    "type": {
      "type": "string",
      "enum": [
        "growth",
        "retention",
        "revenue",
        "community"
      ],
      "default": "growth",
      "description": "Portfolio-level category for parking lot grouping"
    },
    "horizon": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3"
      ],
      "description": "Escape Velocity horizon: H1=Core (protect & extend), H2=Growth (build & scale), H3=Future (explore & incubate)"
    },
    "business_value": {
      "type": "number",
      "description": "Business Value (1-10) for WSJF calculation"
    },
    "time_criticality": {
      "type": "number",
      "description": "Time Criticality (1-10) for WSJF calculation"
    },
    "risk_reduction": {
      "type": "number",
      "description": "Risk Reduction / Opportunity Enablement (1-10) for WSJF calculation"
    },
    "job_size": {
      "type": "number",
      "description": "Job Size / Effort (1-10) for WSJF calculation"
    },
    "wsjf_score": {
      "type": "number",
      "description": "Calculated WSJF score"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the person or team owning this objective"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Overall progress of the objective, calculated from Key Results (0-100)"
    }
  },
  "required": [
    "name"
  ]
}