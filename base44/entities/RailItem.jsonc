{
  "name": "RailItem",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Display label shown under the icon"
    },
    "page": {
      "type": "string",
      "description": "Base44 page name to link to (e.g. 'Home', 'Comms')"
    },
    "query": {
      "type": "string",
      "description": "Optional query string appended to the URL (e.g. 'tab=overview')"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name (e.g. 'Home', 'Trophy', 'MessageCircle')"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Sort order in the rail (lower = higher up)"
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When false the item is hidden from the rail"
    },
    "is_more_item": {
      "type": "boolean",
      "default": false,
      "description": "When true the item appears in the More overflow menu, not the main rail"
    }
  },
  "required": [
    "label",
    "page",
    "icon",
    "order"
  ]
}