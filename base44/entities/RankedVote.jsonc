{
  "name": "RankedVote",
  "type": "object",
  "properties": {
    "voter_email": {
      "type": "string",
      "description": "Email of the user who cast the ranked vote"
    },
    "ballot": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered array of nominee IDs representing the user's ranked choices"
    },
    "season_id": {
      "type": "string",
      "description": "ID of the season this ranked vote belongs to"
    }
  },
  "required": [
    "voter_email",
    "ballot",
    "season_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.voter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.voter_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.voter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.voter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}