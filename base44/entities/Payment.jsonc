{
  "name": "Payment",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "Reference to the Booking entity, when the payment is for a booking"
    },
    "product": {
      "type": "string",
      "description": "What was bought, taken from the checkout session metadata: 'booking', 'pro_membership', 'ground_control_starter', 'archive_donation', 'featured_job', 'featured_service', or a payment plan id"
    },
    "payer_email": {
      "type": "string",
      "description": "Email of the user making the payment"
    },
    "amount_cents": {
      "type": "number",
      "description": "Total transaction amount in cents"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Checkout Session id. The webhook's idempotency key: one order, one payment record."
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "platform_fee_cents": {
      "type": "number",
      "description": "Portion of the amount kept by the platform"
    },
    "provider_amount_cents": {
      "type": "number",
      "description": "Portion of the amount payout to the provider"
    },
    "commission_rate": {
      "type": "number",
      "description": "The commission percentage applied (e.g. 0.15 for 15%)"
    }
  },
  "required": [
    "amount_cents",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}