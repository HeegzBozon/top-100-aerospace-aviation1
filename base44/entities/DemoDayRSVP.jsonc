{
  "name": "DemoDayRSVP",
  "type": "object",
  "properties": {
    "demo_day_id": {
      "type": "string",
      "description": "Demo day event ID"
    },
    "attendee_email": {
      "type": "string",
      "description": "Attendee email"
    },
    "attendee_type": {
      "type": "string",
      "enum": [
        "investor",
        "founder",
        "mentor",
        "press",
        "other"
      ],
      "description": "Type of attendee"
    },
    "attended": {
      "type": "boolean",
      "default": false,
      "description": "Whether they actually attended"
    },
    "feedback": {
      "type": "string",
      "description": "Post-event feedback"
    }
  },
  "required": [
    "demo_day_id",
    "attendee_email"
  ],
  "rls": {
    "create": {
      "data.attendee_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.attendee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.attendee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}