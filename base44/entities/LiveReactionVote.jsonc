{
  "name": "LiveReactionVote",
  "type": "object",
  "properties": {
    "poll_id": {
      "type": "string"
    },
    "voter_id": {
      "type": "string"
    },
    "selected_option": {
      "type": "string"
    }
  },
  "required": [
    "poll_id",
    "voter_id",
    "selected_option"
  ],
  "rls": {
    "create": {
      "data.voter_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}