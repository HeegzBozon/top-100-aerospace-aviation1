{
  "name": "PatronClick",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "PatronDeal whose tracked link was followed."
    },
    "slot_id": {
      "type": "string"
    },
    "issue_number": {
      "type": "number"
    },
    "channel": {
      "type": "string",
      "enum": [
        "issue",
        "linkedin",
        "volume",
        "media_kit"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow"
      ],
      "description": "Which deliverable carried the link. This is what makes a report possible."
    },
    "section": {
      "type": "string",
      "enum": [
        "gold",
        "silver1",
        "silver2",
        "bronze",
        "footer_door"
      ],
      "enumColors": [
        "yellow",
        "gray",
        "gray",
        "pink",
        "blue"
      ],
      "description": "The media kit section the link stood in, stamped by the redirect from the link's own token and forwarded to the Patron as utm_content. Empty when the link carried no section."
    },
    "destination_host": {
      "type": "string",
      "description": "Host the reader was sent to. The full destination is held on the deal, not copied per click."
    },
    "referrer": {
      "type": "string"
    },
    "clicked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "deal_id",
    "channel"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}