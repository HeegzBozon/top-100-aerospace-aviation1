{
  "name": "RoadmapItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the roadmap item (Epic)"
    },
    "description": {
      "type": "string",
      "description": "Brief description"
    },
    "value_stream": {
      "type": "string",
      "enum": [
        "operational",
        "developmental"
      ],
      "default": "operational",
      "description": "Which value stream this belongs to"
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "next_up",
        "in_progress",
        "done"
      ],
      "default": "backlog",
      "description": "Current status"
    },
    "category": {
      "type": "string",
      "description": "Category tag (e.g. Feature, Enhancement, Integration)"
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "enhancement",
        "bug",
        "feedback"
      ],
      "default": "feature",
      "description": "Type of roadmap item"
    },
    "horizon": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3"
      ],
      "description": "Escape Velocity horizon: H1=Core (protect & extend), H2=Growth (build & scale), H3=Future (explore & incubate)"
    },
    "initiative_id": {
      "type": "string",
      "description": "ID of the parent Initiative (Solution Train level) this Epic rolls up to"
    },
    "feedback_id": {
      "type": "string",
      "description": "Linked Feedback entity ID if sourced from feedback/bug"
    },
    "upvotes": {
      "type": "number",
      "default": 0,
      "description": "Number of upvotes"
    },
    "upvoted_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of user emails who upvoted"
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Sort priority within status column"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Target completion date"
    },
    "business_value": {
      "type": "number",
      "description": "Business Value (1-10) for WSJF calculation"
    },
    "time_criticality": {
      "type": "number",
      "description": "Time Criticality (1-10) for WSJF calculation"
    },
    "risk_reduction": {
      "type": "number",
      "description": "Risk Reduction / Opportunity Enablement (1-10) for WSJF calculation"
    },
    "job_size": {
      "type": "number",
      "description": "Job Size / Effort (1-10) for WSJF calculation"
    },
    "wsjf_score": {
      "type": "number",
      "description": "Calculated WSJF score"
    },
    "submitter_email": {
      "type": "string",
      "description": "Email of user who submitted this item"
    }
  },
  "required": [
    "title",
    "value_stream",
    "status"
  ]
}