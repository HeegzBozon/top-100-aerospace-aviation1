{
  "name": "ClientNote",
  "type": "object",
  "properties": {
    "provider_email": {
      "type": "string",
      "description": "Provider who created the note"
    },
    "client_email": {
      "type": "string",
      "description": "Client the note is about"
    },
    "content": {
      "type": "string",
      "description": "Private note content"
    },
    "booking_id": {
      "type": "string",
      "description": "Optional related booking"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for organization"
    }
  },
  "required": [
    "provider_email",
    "client_email",
    "content"
  ]
}