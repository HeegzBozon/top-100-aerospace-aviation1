{
  "name": "FellowProfileSettings",
  "type": "object",
  "properties": {
    "fellow_email": {
      "type": "string",
      "description": "Email of the Fellow who owns these settings. Stable key across User and Nominee records."
    },
    "fellow_id": {
      "type": "string",
      "description": "Optional Nominee record id for the Fellow, when one exists"
    },
    "domain_accent": {
      "type": "string",
      "enum": [
        "space_rd",
        "commercial_aviation",
        "defense",
        "manufacturing",
        "operations",
        "engineering",
        "policy",
        "entrepreneurship"
      ],
      "description": "One of eight domain-derived accents. Defaults are derived from the Fellow's primary discipline."
    },
    "cover_asset_id": {
      "type": "string",
      "description": "Key of a cover from the verified asset library. No user upload."
    },
    "hardware_finish": {
      "type": "string",
      "description": "Key of the curated hardware finish the Fellow has put on their handheld console (one of the approved finish set). Curated choice, never a free-form colour. Display only; never read by discovery, ranking, or scoring."
    },
    "module_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered module keys. Validated server-side against the allowlist; positions 1 and 2 are locked."
    },
    "slide_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered slide region keys for the profile deck. Valid keys: identity, verification, blurb, documents, eight, flightography. Identity locks to position 1 and verification to position 2; client-side enforced via resolveSlideOrder. Expression only; never feeds measurement."
    },
    "slide_hidden": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Slide region keys the Fellow has toggled off their deck. Expression only; never feeds measurement."
    },
    "autoplay_mode": {
      "type": "string",
      "enum": [
        "loop",
        "stop_at_end",
        "manual"
      ],
      "default": "manual",
      "description": "How the profile deck auto-advances. loop = repeat indefinitely; stop_at_end = advance once then halt; manual = no autoplay."
    },
    "dwell_seconds": {
      "type": "number",
      "default": 6,
      "description": "Seconds each slide is displayed during autoplay. Minimum 3."
    },
    "bulletin_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered bulletin board tool keys enabled for this Fellow. Validated server-side against the tool allowlist (dispatch, notes, gallery, quotes, field_notes, reading_list, threads)."
    },
    "cluster_module_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered Bulletin Board tile keys. Fellow-configured; defaults to the registry order when empty."
    },
    "cluster_hidden_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tile keys the Fellow has hidden from their Bulletin Board grid. Expression only; never feeds measurement."
    },
    "cluster_tile_sizes": {
      "type": "object",
      "default": {},
      "description": "Per-tile size overrides for the Bulletin Board grid (e.g. {\"compose\":\"2x2\"}). Valid keys: 1x1, 1x2, 2x1, 2x2. Falls back to the registry default when a key is absent. Expression only; never feeds measurement."
    },
    "six_word_story": {
      "type": "string",
      "description": "Six word story, max 60 characters"
    },
    "about_me": {
      "type": "string",
      "description": "Fellow's 'About me' blurb. Personal expression, max 600 characters."
    },
    "who_id_like_to_meet": {
      "type": "string",
      "description": "Fellow's 'Who I'd like to meet' blurb. Personal expression, max 600 characters."
    },
    "status_key": {
      "type": "string",
      "description": "Key of a curated status from the approved status set. Never free text."
    },
    "status_set_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current status was set. Used to age out stale statuses."
    },
    "eight_public": {
      "type": "boolean",
      "default": true,
      "description": "Whether the Fellow's My TOP 100 positions render on their public profile."
    },
    "activity_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the Fellow acknowledged their profile activity"
    },
    "intent_hire_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Job & Career mode. Independent switch, set by the Fellow alone. Renders the opportunity module and its enquiry route on the public profile and lists the Fellow on the Talent Desk. Never read by discovery ordering, measurement, influence tier, or scoring."
    },
    "intent_commercial_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Deal & BD mode. Independent switch, set by the Fellow alone. Renders the commercial module and its enquiry route on the public profile and lists the Fellow on the Talent Desk. Never read by discovery ordering, measurement, influence tier, or scoring."
    },
    "hire_pitch": {
      "type": "string",
      "description": "Two-line statement of the work the Fellow wants next. Curated length (max 280 characters). Display only."
    },
    "hire_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Keys from the approved capability set only; validated server-side. Display only."
    },
    "hire_availability": {
      "type": "string",
      "enum": [
        "open_now",
        "open_selective",
        "not_looking"
      ],
      "description": "How open the Fellow is to a conversation. Informational on the profile; never used to order, filter, or feature anything."
    },
    "hire_work_preference": {
      "type": "string",
      "enum": [
        "onsite",
        "hybrid",
        "remote",
        "flexible"
      ],
      "description": "Curated work arrangement preference. Display only."
    },
    "hire_regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Keys from the approved region set only. Display only."
    },
    "commercial_pitch": {
      "type": "string",
      "description": "What the Fellow can be engaged to do. Curated length (max 280 characters). Display only."
    },
    "commercial_offerings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Keys from the approved offering set only; validated server-side. Display only."
    },
    "commercial_engagements": {
      "type": "string",
      "enum": [
        "open_now",
        "open_selective",
        "closed"
      ],
      "description": "How open the Fellow is to a commercial engagement. Informational only; never used to order, filter, or feature anything."
    },
    "commercial_sectors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Domain keys the Fellow will take commercial work in. Display only."
    },
    "inquiry_route": {
      "type": "string",
      "enum": [
        "form",
        "form_linkedin"
      ],
      "description": "Public contact preference. 'form' = the private enquiry form only; 'form_linkedin' = the form plus a LinkedIn key when the Fellow has a profile link. The Fellow's email address is never rendered publicly."
    },
    "dossier_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether visitors may download the standardized one-page dossier composed from the public record. Never read by discovery, ranking, or scoring."
    },
    "intent_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the intent switches or their configuration were last written."
    },
    "inquiry_last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the Fellow opened their enquiry desk"
    },
    "documentary_prompts": {
      "type": "object",
      "default": {},
      "description": "The Fellow's own answers to the documentary story prompts, keyed by prompt key (first_light, turning_point, hardest_problem, what_next). Each answer renders as an interview excerpt in the matching chapter of their documentary record. Display only; never read by discovery, ranking, scoring, or measurement."
    },
    "documentary_media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Stable key for the contribution"
          },
          "chapter": {
            "type": "string",
            "description": "Chapter key the contribution is cut into (opening, credential, work, route, contributions, words, eight, next)"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "clip",
              "recording",
              "document"
            ],
            "description": "What the contribution is: a still, a moving image, an interview recording, or a supporting document"
          },
          "url": {
            "type": "string",
            "description": "Public file URL for the contribution"
          },
          "caption": {
            "type": "string",
            "description": "Caption or credit printed under the contribution"
          }
        }
      },
      "default": [],
      "description": "Stills, clips, interview recordings and documents the Fellow has contributed to their documentary record. Display only; never read by discovery, ranking, scoring, or measurement."
    }
  },
  "required": [
    "fellow_email"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.fellow_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.fellow_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.fellow_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}