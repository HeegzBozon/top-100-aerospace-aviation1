{
  "name": "Story",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Story title"
    },
    "description": {
      "type": "string",
      "description": "Acceptance criteria / description"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done",
        "blocked"
      ],
      "default": "todo",
      "description": "Team-level workflow status"
    },
    "type": {
      "type": "string",
      "enum": [
        "frontend",
        "backend",
        "design",
        "devops"
      ],
      "default": "frontend",
      "description": "Team-level category for parking lot grouping"
    },
    "horizon": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3"
      ],
      "description": "Escape Velocity horizon: H1=Core (protect & extend), H2=Growth (build & scale), H3=Future (explore & incubate)"
    },
    "story_points": {
      "type": "number",
      "default": 0,
      "description": "Story points for effort estimation"
    },
    "assignee_email": {
      "type": "string",
      "description": "Email of the team member assigned to this story"
    },
    "roadmap_item_id": {
      "type": "string",
      "description": "ID of the parent RoadmapItem (Epic) this story belongs to"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Sort priority within the parent Epic"
    },
    "business_value": {
      "type": "number",
      "description": "Business Value (1-10) for WSJF calculation"
    },
    "time_criticality": {
      "type": "number",
      "description": "Time Criticality (1-10) for WSJF calculation"
    },
    "risk_reduction": {
      "type": "number",
      "description": "Risk Reduction / Opportunity Enablement (1-10) for WSJF calculation"
    },
    "job_size": {
      "type": "number",
      "description": "Job Size / Effort (1-10) for WSJF calculation"
    },
    "wsjf_score": {
      "type": "number",
      "description": "Calculated WSJF score"
    }
  },
  "required": [
    "title"
  ]
}