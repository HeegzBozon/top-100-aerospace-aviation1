{
  "name": "Story",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string",
      "description": "Email of the Fellow who posted the story"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of the author"
    },
    "author_avatar_url": {
      "type": "string",
      "description": "Author avatar URL"
    },
    "media_url": {
      "type": "string",
      "description": "Image URL for the story frame (uploaded)"
    },
    "caption": {
      "type": "string",
      "description": "Optional short caption, max 200 characters"
    }
  },
  "required": [
    "author_email",
    "media_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.author_email": "{{user.email}}"
    },
    "update": {
      "data.author_email": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}