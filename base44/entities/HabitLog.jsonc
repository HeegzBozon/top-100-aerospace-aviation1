{
  "name": "HabitLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "habit_type": {
      "type": "string",
      "enum": [
        "WATER",
        "RBT",
        "BALLOT",
        "SIDEQUEST"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "quantity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ios",
        "android",
        "web"
      ]
    }
  },
  "required": [
    "user_id",
    "habit_type",
    "occurred_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}