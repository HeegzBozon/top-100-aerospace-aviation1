{
  "name": "NominationIntake",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string",
      "description": "Source SurveyResponse ID for the bundled nomination submission"
    },
    "survey_id": {
      "type": "string",
      "description": "Source survey ID"
    },
    "nomination_type": {
      "type": "string",
      "enum": [
        "women",
        "men",
        "angels"
      ],
      "description": "Which nomination track this record belongs to"
    },
    "nominee_name": {
      "type": "string",
      "description": "Name of the nominated person"
    },
    "nominee_email": {
      "type": "string",
      "description": "Email for the nominated person if provided"
    },
    "role_org": {
      "type": "string",
      "description": "Role and organization for people nominations"
    },
    "firm": {
      "type": "string",
      "description": "Firm or investment vehicle for angel nominations"
    },
    "link": {
      "type": "string",
      "description": "LinkedIn, website, or source link"
    },
    "location": {
      "type": "string",
      "description": "City/country or location"
    },
    "reason": {
      "type": "string",
      "description": "Why this person deserves recognition"
    },
    "investing_in": {
      "type": "string",
      "description": "Investment focus for angel nominations"
    },
    "share_name": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        ""
      ],
      "default": "",
      "description": "Whether the nominator allows their name to be shared"
    },
    "nominator_name": {
      "type": "string",
      "description": "Name of the person submitting the nomination"
    },
    "nominator_email": {
      "type": "string",
      "description": "Email of the person submitting the nomination"
    },
    "nominator_connection": {
      "type": "string",
      "description": "Submitter relationship to aerospace/community"
    },
    "source": {
      "type": "string",
      "default": "unified_nomination_hub",
      "description": "Where this intake record came from"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewing",
        "approved",
        "rejected",
        "archived"
      ],
      "default": "new",
      "description": "Admin review status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes"
    },
    "nominee_id": {
      "type": "string",
      "description": "Linked Nominee record ID after approval, if applicable"
    }
  },
  "required": [
    "nomination_type",
    "nominee_name",
    "nominator_email"
  ]
}