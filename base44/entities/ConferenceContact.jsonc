{
  "name": "ConferenceContact",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Email of the Fellow whose rolodex holds this contact, denormalized for display. Access is anchored on created_by_id."
    },
    "full_name": {
      "type": "string",
      "description": "The person's name, as it reads on the card"
    },
    "first_name": {
      "type": "string",
      "description": "First name, split from the full name when it is not printed separately"
    },
    "last_name": {
      "type": "string",
      "description": "Last name, split from the full name when it is not printed separately"
    },
    "role_title": {
      "type": "string",
      "description": "Role or title as printed on the card"
    },
    "company": {
      "type": "string",
      "description": "Organization or unit they stand for"
    },
    "email": {
      "type": "string",
      "description": "Email address, validated before it is saved"
    },
    "phone": {
      "type": "string",
      "description": "Telephone number as printed"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL when one is printed or added by hand"
    },
    "website": {
      "type": "string",
      "description": "Website or organization page"
    },
    "city": {
      "type": "string",
      "description": "City they work from"
    },
    "country": {
      "type": "string",
      "description": "Country they work from"
    },
    "conference_name": {
      "type": "string",
      "description": "The show the Fellow met them at"
    },
    "met_on": {
      "type": "string",
      "format": "date",
      "description": "The day they met"
    },
    "met_context": {
      "type": "string",
      "description": "Where in the show they met: the hall, the stand, the room, the table"
    },
    "notes": {
      "type": "string",
      "description": "Relationship notes: what was said, what matters to them, what to remember"
    },
    "next_step": {
      "type": "string",
      "description": "What was agreed to happen next. The line the follow-up is built from."
    },
    "last_touch": {
      "type": "string",
      "format": "date-time",
      "description": "When the relationship was last worked. Stamped when a touch is logged."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Free expressive tags. Never governance-bearing; carry zero measurement weight."
    },
    "card_file_uri": {
      "type": "string",
      "description": "The business card image as captured, stored privately (never a public URL) and read back through a signed URL."
    },
    "source": {
      "type": "string",
      "enum": [
        "card",
        "manual"
      ],
      "default": "manual",
      "description": "How the contact arrived: read from a captured card, or typed in by hand."
    },
    "room_id": {
      "type": "string",
      "description": "ID of the ConferenceRoom the contact was captured in. Ties a capture to the show it happened at without copying the conference record."
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "investor",
        "customer",
        "hire",
        "partner",
        "supplier",
        "mentor",
        "press",
        "peer"
      ],
      "description": "Curated relationship type, chosen in one tap at capture. Private to the Fellow; never read by discovery, directory ordering, measurement, or scoring."
    },
    "heat": {
      "type": "string",
      "enum": [
        "hot",
        "warm",
        "cool"
      ],
      "description": "How warm the conversation was: asked for a next step, real interest, or polite. Private to the Fellow; never measurement-bearing."
    },
    "promise": {
      "type": "string",
      "description": "What the Fellow said they would send or do. The line the first follow-up is built from, and the item the Fellow owes."
    },
    "consent_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Fellow confirmed the person agreed to have their details kept. A capture is never saved without this."
    },
    "follow_up_draft": {
      "type": "string",
      "description": "The personalised follow-up the Fellow composed from this capture. Drafted in the app, edited by the Fellow, and sent by the Fellow from their own account."
    },
    "follow_up_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Fellow has marked the follow-up as sent. Nothing is ever sent automatically by the platform."
    },
    "follow_up_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Fellow marked the follow-up as sent"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "none",
        "meeting",
        "opportunity",
        "network",
        "dormant",
        "won",
        "lost"
      ],
      "default": "none",
      "description": "Where the relationship stands after the show, recorded by the Fellow. Private progress only; never measurement-bearing."
    },
    "resurface_room_id": {
      "type": "string",
      "description": "ID of a future ConferenceRoom this contact is to be resurfaced at. Only settable when both parties are listed on that room's roster."
    },
    "resurface_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the contact is armed to resurface at the next shared show"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}