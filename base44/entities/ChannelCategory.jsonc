{
  "name": "ChannelCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category display name"
    },
    "icon": {
      "type": "string",
      "description": "Emoji icon for the category"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Sort order for categories"
    },
    "color": {
      "type": "string",
      "description": "Hex color for category label"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}