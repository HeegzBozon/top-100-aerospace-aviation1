{
  "name": "PairwiseVote",
  "type": "object",
  "properties": {
    "voter_email": {
      "type": "string",
      "description": "Email of the user who cast the vote"
    },
    "winner_nominee_id": {
      "type": "string",
      "description": "The ID of the nominee chosen as the winner in the pair"
    },
    "loser_nominee_id": {
      "type": "string",
      "description": "The ID of the nominee not chosen in the pair"
    },
    "season_id": {
      "type": "string",
      "description": "The season in which the vote was cast"
    },
    "voter_role": {
      "type": "string",
      "description": "Role the voter held when the ballot was cast: 'admin' or 'user'. Recorded at write time so a ballot can be filtered by who cast it without reading the User record later."
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "True when the ballot was cast by an administrator walking the voting flow. Test ballots are recorded rather than refused, and can be excluded from measurement and reporting by filtering on this flag."
    }
  },
  "required": [
    "voter_email",
    "winner_nominee_id",
    "loser_nominee_id",
    "season_id"
  ]
}