{
  "name": "ProviderApplication",
  "type": "object",
  "properties": {
    "applicant_email": {
      "type": "string",
      "description": "Email of the user applying"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "service_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categories they intend to offer"
    },
    "experience_summary": {
      "type": "string",
      "description": "Brief bio or justification"
    },
    "portfolio_link": {
      "type": "string",
      "description": "Link to work samples"
    },
    "linkedin_profile": {
      "type": "string",
      "description": "LinkedIn URL"
    }
  },
  "required": [
    "applicant_email",
    "experience_summary"
  ]
}