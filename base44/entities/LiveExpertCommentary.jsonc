{
  "name": "LiveExpertCommentary",
  "type": "object",
  "properties": {
    "expert_name": {
      "type": "string"
    },
    "expert_title": {
      "type": "string"
    },
    "expert_avatar": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "current_objective": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "expert_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}