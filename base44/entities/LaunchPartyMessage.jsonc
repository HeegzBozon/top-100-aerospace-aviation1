{
  "name": "LaunchPartyMessage",
  "type": "object",
  "properties": {
    "party_id": {
      "type": "string",
      "description": "The LaunchParty room the line was said in. Empty when the line was said in the theatre's open room for a mission that has no party."
    },
    "launch_id": {
      "type": "string",
      "description": "Launch library id of the mission on the pad when the line was said."
    },
    "author_name": {
      "type": "string",
      "description": "Display name of sender"
    },
    "author_email": {
      "type": "string",
      "description": "Email of sender, stamped from the signed-in member and never from the form."
    },
    "text": {
      "type": "string",
      "description": "Message body"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was sent"
    }
  },
  "required": [
    "launch_id",
    "author_email",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}