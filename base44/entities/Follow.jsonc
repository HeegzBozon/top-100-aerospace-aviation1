{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_email": {
      "type": "string",
      "description": "Email of the Fellow who follows"
    },
    "follower_name": {
      "type": "string",
      "description": "Display name of the follower, denormalized for display"
    },
    "follower_avatar_url": {
      "type": "string",
      "description": "Avatar URL of the follower, denormalized for display"
    },
    "following_email": {
      "type": "string",
      "description": "Address the followed Fellow can be written to, where the record holds one. A profile with no address on record keeps its profile key here instead (see following_profile_id), so every profile can be followed."
    },
    "following_name": {
      "type": "string",
      "description": "Display name of the followed Fellow, denormalized for display"
    },
    "following_avatar_url": {
      "type": "string",
      "description": "Avatar URL of the followed Fellow, denormalized for display"
    },
    "following_profile_id": {
      "type": "string",
      "description": "Nominee record the follow stands against. This is the identity of a follow: the address above is only what the row can say about that record, and most records have none."
    }
  },
  "required": [
    "follower_email",
    "following_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.follower_email": "{{user.email}}"
        },
        {
          "data.following_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.follower_email": "{{user.email}}"
    },
    "update": {
      "data.follower_email": "{{user.email}}"
    },
    "delete": {
      "data.follower_email": "{{user.email}}"
    }
  }
}