{
  "name": "StatusUpdate",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Headline of the release note or status update"
    },
    "body": {
      "type": "string",
      "description": "What shipped, changed or is next"
    },
    "scope": {
      "type": "string",
      "enum": [
        "platform",
        "personal"
      ],
      "default": "personal",
      "description": "Platform release notes are written by admins; personal updates by any member"
    },
    "season_name": {
      "type": "string",
      "description": "Season label the update belongs to, e.g. 'Fall 2026'"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "released"
      ],
      "default": "draft"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "author_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "scope"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "released"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.scope": "personal"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.scope": "personal"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}