{
  "name": "ContentIdea",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner of this content idea"
    },
    "title": {
      "type": "string",
      "description": "Six-word story hook line"
    },
    "elevator_pitch": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "1\u20135 sentence elevator pitch for this content idea"
    },
    "body": {
      "type": "string",
      "description": "Full draft content or notes"
    },
    "stage": {
      "type": "string",
      "enum": [
        "idea",
        "draft",
        "in_review",
        "revisions",
        "approved",
        "scheduled",
        "published"
      ],
      "default": "idea",
      "description": "Current editorial workflow stage"
    },
    "platform": {
      "type": "string",
      "enum": [
        "linkedin",
        "instagram",
        "threads",
        "all"
      ],
      "default": "linkedin",
      "description": "Target platform"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Content tags or themes"
    },
    "review_notes": {
      "type": "string",
      "description": "Reviewer feedback or revision notes"
    },
    "scheduled_post_id": {
      "type": "string",
      "description": "Linked ScheduledPost ID once promoted to scheduling"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Editorial priority"
    }
  },
  "required": [
    "user_email",
    "title",
    "stage"
  ]
}