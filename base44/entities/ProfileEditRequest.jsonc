{
  "name": "ProfileEditRequest",
  "type": "object",
  "properties": {
    "nominee_id": {
      "type": "string",
      "description": "ID of the nominee whose profile is being edited"
    },
    "field_name": {
      "type": "string",
      "description": "The field being edited (e.g., 'bio', 'achievements', 'linkedin_profile_url')"
    },
    "current_value": {
      "type": "string",
      "description": "Current value of the field"
    },
    "proposed_value": {
      "type": "string",
      "description": "Proposed new value"
    },
    "reason": {
      "type": "string",
      "description": "Explanation for the proposed edit"
    },
    "source_url": {
      "type": "string",
      "description": "Optional evidence/source link"
    },
    "submitted_by": {
      "type": "string",
      "description": "Email of user who submitted the edit"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Status of the edit request"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of admin who reviewed the request"
    },
    "review_notes": {
      "type": "string",
      "description": "Admin notes on approval/rejection"
    },
    "votes_for": {
      "type": "number",
      "default": 0,
      "description": "Community upvotes for this suggestion"
    },
    "votes_against": {
      "type": "number",
      "default": 0,
      "description": "Community downvotes for this suggestion"
    }
  },
  "required": [
    "nominee_id",
    "field_name",
    "proposed_value",
    "reason",
    "submitted_by"
  ]
}