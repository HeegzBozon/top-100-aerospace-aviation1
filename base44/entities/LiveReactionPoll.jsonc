{
  "name": "LiveReactionPoll",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "The poll question"
    },
    "type": {
      "type": "string",
      "enum": [
        "poll",
        "trivia"
      ],
      "default": "poll"
    },
    "poll_type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "yes_no",
        "emoji"
      ],
      "default": "multiple_choice"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available options"
    },
    "correct_answer": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "question",
    "options"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}