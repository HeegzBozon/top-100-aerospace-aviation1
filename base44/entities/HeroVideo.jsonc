{
  "name": "HeroVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Label for the video (e.g. 'Yoga Studio')"
    },
    "video_url": {
      "type": "string",
      "description": "URL of the uploaded video file"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this video is shown in the hero"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Order in which videos appear"
    }
  },
  "required": [
    "title",
    "video_url"
  ]
}