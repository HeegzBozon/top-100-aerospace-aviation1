{
  "name": "Profile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Link to the built-in User via email"
    },
    "headline": {
      "type": "string",
      "description": "Professional headline"
    },
    "biography": {
      "type": "string",
      "description": "Full biography"
    },
    "organization": {
      "type": "string",
      "description": "Current organization"
    },
    "location": {
      "type": "string",
      "description": "City, Country"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn Profile URL"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "service_bio": {
      "type": "string",
      "description": "Specific bio for the services marketplace"
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categories of services offered"
    },
    "google_calendar_id": {
      "type": "string",
      "description": "The specific calendar ID to sync with (optional)"
    },
    "stripe_connect_account_id": {
      "type": "string",
      "description": "Stripe Connected Account ID (acct_...) for payouts"
    },
    "stripe_payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed Stripe onboarding"
    },
    "availability_settings": {
      "type": "object",
      "properties": {
        "slot_interval_minutes": {
          "type": "number",
          "default": 15
        },
        "buffer_minutes": {
          "type": "number",
          "default": 0
        },
        "max_days_advance": {
          "type": "number",
          "default": 60
        },
        "min_notice_hours": {
          "type": "number",
          "default": 2
        },
        "weekly_hours": {
          "type": "object",
          "description": "Day-by-day availability e.g. {monday: {start: '09:00', end: '17:00'}}"
        }
      },
      "description": "Provider availability configuration"
    }
  },
  "required": [
    "user_email"
  ]
}