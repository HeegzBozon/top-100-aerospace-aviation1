{
  "name": "Initiative",
  "description": "Represents a Solution Train Epic, a large-scale strategic task that may span multiple Program Increments.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the Initiative"
    },
    "description": {
      "type": "string",
      "description": "A detailed description of the Initiative"
    },
    "status": {
      "type": "string",
      "enum": [
        "funnel",
        "reviewing",
        "analyzing",
        "portfolio_backlog",
        "implementing",
        "done"
      ],
      "default": "funnel",
      "description": "The current state of the Initiative in the Solution Train Kanban"
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "platform",
        "operations",
        "research"
      ],
      "default": "feature",
      "description": "Solution-level category for parking lot grouping"
    },
    "horizon": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3"
      ],
      "description": "Escape Velocity horizon: H1=Core (protect & extend), H2=Growth (build & scale), H3=Future (explore & incubate)"
    },
    "objective_id": {
      "type": "string",
      "description": "ID of the parent Objective (Strategic Theme) this Initiative rolls up to"
    },
    "business_value": {
      "type": "number",
      "description": "Business Value (1-10) for WSJF calculation"
    },
    "time_criticality": {
      "type": "number",
      "description": "Time Criticality (1-10) for WSJF calculation"
    },
    "risk_reduction": {
      "type": "number",
      "description": "Risk Reduction / Opportunity Enablement (1-10) for WSJF calculation"
    },
    "job_size": {
      "type": "number",
      "description": "Job Size / Effort (1-10) for WSJF calculation"
    },
    "wsjf_score": {
      "type": "number",
      "description": "Calculated WSJF score"
    }
  },
  "required": [
    "name"
  ]
}