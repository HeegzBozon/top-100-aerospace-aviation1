{
  "name": "MailSend",
  "type": "object",
  "description": "One address, one letter. The receipt behind a send: what the mail service answered for each person, and the reason when it refused. It is also what makes a letter unrepeatable.",
  "properties": {
    "issue_id": {
      "type": "string",
      "description": "The MailIssue this row belongs to."
    },
    "email": {
      "type": "string",
      "description": "The address written to, lowercased. The dedupe key within a letter."
    },
    "name": {
      "type": "string",
      "description": "The name the address is filed under, as the audience ledger held it."
    },
    "source": {
      "type": "string",
      "description": "Which ledger the address came from: member, subscriber, or both."
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "skipped"
      ],
      "default": "sent",
      "description": "Whether the mail service accepted, refused, or the address was held back (an opt-out, or an address that fails the validity gate)."
    },
    "reason": {
      "type": "string",
      "description": "Why a send failed or was held back, as the mail service or the gate reported it."
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the attempt was filed."
    }
  },
  "required": [
    "issue_id",
    "email",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}