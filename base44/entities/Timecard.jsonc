{
  "name": "Timecard",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "time",
        "expense"
      ],
      "default": "time",
      "description": "Whether the entry records hours worked or money spent."
    },
    "entry_date": {
      "type": "string",
      "format": "date",
      "description": "The day the hours were worked or the expense incurred."
    },
    "description": {
      "type": "string",
      "description": "What the hours or the expense were for."
    },
    "payee": {
      "type": "string",
      "description": "Who the entry belongs to: the person who worked the hours, or the vendor paid for the expense."
    },
    "project": {
      "type": "string",
      "description": "The project or cost centre the entry is filed against."
    },
    "category": {
      "type": "string",
      "enum": [
        "editorial",
        "research",
        "production",
        "travel",
        "lodging",
        "meals",
        "software",
        "equipment",
        "services",
        "other"
      ],
      "default": "other",
      "description": "Curated category for reporting."
    },
    "hours": {
      "type": "number",
      "description": "Hours worked (time entries only)."
    },
    "rate_cents": {
      "type": "number",
      "description": "Hourly rate in cents (time entries only)."
    },
    "amount_cents": {
      "type": "number",
      "description": "The money the entry carries in cents: hours x rate for time, the receipt total for an expense."
    },
    "billable": {
      "type": "boolean",
      "default": true,
      "description": "Whether the entry is recoverable from a client."
    },
    "reimbursable": {
      "type": "boolean",
      "default": false,
      "description": "Whether an expense is to be paid back to the person who incurred it."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "paid"
      ],
      "default": "draft",
      "description": "Where the entry stands in settlement."
    },
    "notes": {
      "type": "string",
      "description": "Internal note. Never printed on a report."
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "worklog"
      ],
      "default": "manual",
      "description": "How the entry reached the ledger: typed by hand, or read out of a work log the person kept elsewhere. A worklog session carries the session's own clock times and its task breakdown."
    },
    "session_start": {
      "type": "string",
      "description": "The wall-clock time the session began, as local time on entry_date (e.g. 2026-11-02T09:00). Empty when the log states no start."
    },
    "session_end": {
      "type": "string",
      "description": "The wall-clock time the session ended, as local time on entry_date. Empty when the log states no end."
    },
    "timezone": {
      "type": "string",
      "description": "The zone the session's clock times are read in, e.g. America/Los_Angeles. Held so a timestamp is never read as UTC by accident."
    },
    "duration_minutes": {
      "type": "number",
      "description": "Elapsed wall-clock minutes the source reported for the session. This is the measured figure; it is not active typing time, and it is kept apart from the task split below."
    },
    "task_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "minutes": {
            "type": "number"
          },
          "estimated": {
            "type": "boolean",
            "default": true
          },
          "note": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "The discrete jobs inside a session. 'estimated' is true when the source gave no minutes for that job and the split was allocated across the session \u2014 an allocation, never a measurement."
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "What the session produced: drafts, files, links or decisions, kept with the session as evidence."
    },
    "source_fingerprint": {
      "type": "string",
      "description": "Stable hash of the session's date, clock times, project and summary. Second import of the same log is recognised by it."
    },
    "source_label": {
      "type": "string",
      "description": "Where the session was read from: a pasted log, or the name of the file it was exported to."
    },
    "source_text": {
      "type": "string",
      "description": "The original work log text, kept for audit so the filed session can be read back against what was written."
    }
  },
  "required": [
    "kind",
    "entry_date",
    "description"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}