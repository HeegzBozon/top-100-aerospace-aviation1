{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the event occurs"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "celebration",
        "training",
        "social",
        "awards",
        "meetup"
      ],
      "description": "Type of event"
    },
    "location": {
      "type": "string",
      "description": "Event location (virtual/physical)"
    },
    "organizer": {
      "type": "string",
      "description": "Event organizer"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of attendee emails"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "ongoing",
        "completed"
      ],
      "default": "upcoming",
      "description": "Event status"
    },
    "is_official": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is an official TOP 100 hosted/sponsored event"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Events On Air - public events anyone can find, view, and upload photos to"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Cover image URL for the event"
    },
    "party_mode": {
      "type": "boolean",
      "default": false,
      "description": "Enable real-time photo sharing from mobile devices"
    },
    "rsvp_count": {
      "type": "number",
      "default": 0,
      "description": "Number of people who RSVP'd as going"
    }
  },
  "required": [
    "title",
    "event_date",
    "event_type"
  ]
}