{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the event occurs"
    },
    "event_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional end time for multi-hour or multi-day events"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "celebration",
        "training",
        "social",
        "awards",
        "meetup"
      ],
      "description": "Legacy type bucket (kept for backward compat with EventManagement)"
    },
    "experience_type": {
      "type": "string",
      "enum": [
        "Workshop",
        "Office Hours",
        "Live Build",
        "Build Challenge",
        "AMA",
        "Mission Theatre",
        "Awards",
        "Social",
        "Celebration",
        "Meetup",
        "Training"
      ],
      "description": "The experience format \u2014 mirrors the Base44 ambassador event taxonomy. Programs people join & events they participate in."
    },
    "chamber_ritual": {
      "type": "string",
      "enum": [
        "Ribbon Cutting",
        "Networking Mixer",
        "Policy Mixer",
        "Advocacy Briefing",
        "Incubator Milestone",
        "Demo Day",
        "Mentor Office Hours",
        "Awards Gala",
        "Workshop",
        "AMA",
        "Build Challenge",
        "Celebration"
      ],
      "description": "Chamber 2.0 ritual classification \u2014 groups events by the role they play in the aerospace ecosystem (connect, advocate, enable)."
    },
    "member_tier": {
      "type": "string",
      "enum": [
        "Public",
        "Member",
        "Verified",
        "Premium"
      ],
      "default": "Public",
      "description": "Minimum membership tier required to RSVP / access this event. Drives the exclusive-chamber gating."
    },
    "guild": {
      "type": "string",
      "description": "The guild/community this event feeds (e.g., Builders, Mission Control, Local Legends, Investors, Alumni). Drives the Attend an Event \u2192 Join a Guild bridge."
    },
    "location": {
      "type": "string",
      "description": "Event location (virtual/physical)"
    },
    "meeting_url": {
      "type": "string",
      "description": "Virtual meeting / livestream link"
    },
    "organizer": {
      "type": "string",
      "description": "Event organizer (legacy display field)"
    },
    "host_email": {
      "type": "string",
      "description": "Email of the host / community ambassador who created the event"
    },
    "host_name": {
      "type": "string",
      "description": "Display name of the host"
    },
    "host_avatar_url": {
      "type": "string",
      "description": "Host avatar URL"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of attendee emails (RSVPs)"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "ongoing",
        "completed"
      ],
      "default": "upcoming",
      "description": "Lifecycle status of the event"
    },
    "source": {
      "type": "string",
      "enum": [
        "official",
        "community"
      ],
      "default": "official",
      "description": "Whether this is an official TOP 100 event or community-submitted"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved",
      "description": "Approval workflow for community-submitted events. Official events default to approved."
    },
    "submitted_by_email": {
      "type": "string",
      "description": "Email of the community member who submitted the event"
    },
    "is_official": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is an official TOP 100 hosted/sponsored event"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Events On Air - public events anyone can find, view, and upload photos to"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Cover image URL for the event"
    },
    "capacity": {
      "type": "number",
      "description": "Maximum attendees (0 = unlimited)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags / topics"
    },
    "party_mode": {
      "type": "boolean",
      "default": false,
      "description": "Enable real-time photo sharing from mobile devices"
    },
    "rsvp_count": {
      "type": "number",
      "default": 0,
      "description": "Number of people who RSVP'd as going"
    }
  },
  "required": [
    "title",
    "event_date",
    "experience_type"
  ]
}