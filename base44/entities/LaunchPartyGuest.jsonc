{
  "name": "LaunchPartyGuest",
  "type": "object",
  "properties": {
    "party_id": {
      "type": "string",
      "description": "The LaunchParty this seat belongs to."
    },
    "party_code": {
      "type": "string",
      "description": "The party's invitation code, carried with the seat so a door can be read without loading the party."
    },
    "guest_name": {
      "type": "string",
      "description": "The name the guest is listed under on the door."
    },
    "guest_email": {
      "type": "string",
      "description": "The guest's own address. A Fellow takes their own seat, so this always matches the member who joined."
    },
    "status": {
      "type": "string",
      "enum": [
        "going",
        "maybe",
        "declined"
      ],
      "default": "going",
      "description": "The guest's answer on the invitation."
    },
    "note": {
      "type": "string",
      "description": "Optional line the guest leaves with the host."
    }
  },
  "required": [
    "party_id",
    "guest_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.guest_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}