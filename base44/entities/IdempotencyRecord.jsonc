{
  "name": "IdempotencyRecord",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "maxLength": 64
    },
    "request_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "response_digest": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "key",
    "first_seen_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}