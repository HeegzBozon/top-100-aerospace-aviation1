{
  "name": "Bulletin",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string",
      "description": "Email of the Fellow who posted the bulletin. Platform bulletins use the 'platform' sentinel."
    },
    "author_name": {
      "type": "string",
      "description": "Display name of the author"
    },
    "author_avatar_url": {
      "type": "string",
      "description": "Author avatar URL"
    },
    "scope": {
      "type": "string",
      "enum": [
        "platform",
        "network"
      ],
      "default": "network",
      "description": "'platform' = institutional announcement (admin-only). 'network' = Fellow-authored bulletin."
    },
    "title": {
      "type": "string",
      "description": "Bulletin subject line, max 120 characters"
    },
    "body": {
      "type": "string",
      "description": "Bulletin body, max 1000 characters"
    },
    "link": {
      "type": "string",
      "description": "Optional CTA route for platform bulletins (e.g. /nominate)"
    }
  },
  "required": [
    "author_email"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.scope": {
            "$ne": "platform"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}