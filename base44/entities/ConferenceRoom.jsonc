{
  "name": "ConferenceRoom",
  "type": "object",
  "properties": {
    "conference_name": {
      "type": "string",
      "description": "Display name of the conference, e.g. 'IAC 2026'. The conference itself is this record; its focus areas are the rooms inside it."
    },
    "conference_series": {
      "type": "string",
      "description": "Recurring series key, e.g. 'IAC', 'Paris Air Show', 'NBAA-BACE'"
    },
    "organizer": {
      "type": "string",
      "description": "Official organizing body, e.g. 'International Astronautical Federation'"
    },
    "city": {
      "type": "string",
      "description": "Host city"
    },
    "country": {
      "type": "string",
      "description": "Host country"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Event start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Event end date"
    },
    "venue": {
      "type": "string",
      "description": "Venue or convention center"
    },
    "official_url": {
      "type": "string",
      "description": "Official show website"
    },
    "domain_focus": {
      "type": "string",
      "enum": [
        "space_rd",
        "commercial_aviation",
        "defense",
        "manufacturing",
        "operations",
        "engineering",
        "policy",
        "entrepreneurship"
      ],
      "description": "Primary domain the conference is oriented around"
    },
    "description": {
      "type": "string",
      "description": "What this conference is, and what its rooms are coordinating. Authored by the host."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "live",
        "closed",
        "archived"
      ],
      "default": "draft",
      "description": "Lifecycle of the conference. 'draft' = hidden from Fellows; 'open' = attendance declarations accepted; 'live' = event in progress; 'closed' = event ended, record finalized; 'archived' = immutable."
    },
    "facilitator_email": {
      "type": "string",
      "description": "Email of the host who owns this conference. The host and administrators are the only parties who may edit it."
    },
    "facilitator_name": {
      "type": "string",
      "description": "Display name of the host"
    },
    "focus_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "lead_email": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Self-organizing sub-rooms inside the conference"
    },
    "attendance_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether attendance has been independently verified for Flightography write. False until verification is complete; declared attendance never self-attests to the record."
    },
    "patron_of_record_name": {
      "type": "string",
      "description": "Sponsor attribution label, shown as 'Patron of Record'. Visibility only; confers zero selection influence. Firewall-enforced: never read by discovery, ranking, or scoring."
    },
    "notes": {
      "type": "string",
      "description": "Host teardown notes and production observations"
    },
    "cover_key": {
      "type": "string",
      "enum": [
        "none",
        "orbit",
        "launch",
        "runway",
        "lunar",
        "horizon"
      ],
      "default": "none",
      "description": "Key of a cover from the verified asset library. Curated choice, never a user upload. Display only; never read by discovery ordering, ranking, or scoring."
    },
    "host_organization": {
      "type": "string",
      "description": "The approved host's organization, denormalized at publish time for display on the conference record"
    },
    "registration_url": {
      "type": "string",
      "description": "External registration or ticket page, when the host runs registration elsewhere. Held for future in-platform registration; this release only links out."
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the conference was first opened to the network"
    }
  },
  "required": [
    "conference_name",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": {
            "$ne": "draft"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.facilitator_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.facilitator_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}