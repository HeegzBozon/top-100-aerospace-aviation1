{
  "name": "ConferenceRoom",
  "type": "object",
  "properties": {
    "conference_name": {
      "type": "string",
      "description": "Display name of the external industry event, e.g. 'IAC 2026'. TOP 100 is not the host."
    },
    "conference_series": {
      "type": "string",
      "description": "Recurring series key, e.g. 'IAC', 'Paris Air Show', 'NBAA-BACE'"
    },
    "organizer": {
      "type": "string",
      "description": "Official organizing body, e.g. 'International Astronautical Federation'"
    },
    "city": {
      "type": "string",
      "description": "Host city"
    },
    "country": {
      "type": "string",
      "description": "Host country"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Event start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Event end date"
    },
    "venue": {
      "type": "string",
      "description": "Venue or convention center"
    },
    "official_url": {
      "type": "string",
      "description": "Official show website. TOP 100 is not the host."
    },
    "domain_focus": {
      "type": "string",
      "enum": [
        "space_rd",
        "commercial_aviation",
        "defense",
        "manufacturing",
        "operations",
        "engineering",
        "policy",
        "entrepreneurship"
      ],
      "description": "Primary domain the room is oriented around"
    },
    "description": {
      "type": "string",
      "description": "What this Mission Room is coordinating. Concierge-authored."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "live",
        "closed",
        "archived"
      ],
      "default": "draft",
      "description": "Lifecycle of the room. 'draft' = hidden from Fellows; 'open' = RSVPs accepted; 'live' = event in progress; 'closed' = event ended, record finalized; 'archived' = immutable."
    },
    "facilitator_email": {
      "type": "string",
      "description": "Email of the Fellow or staff facilitating the room"
    },
    "facilitator_name": {
      "type": "string",
      "description": "Display name of the facilitator"
    },
    "focus_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "lead_email": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Self-organizing sub-room focus topics"
    },
    "attendance_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether attendance has been independently verified for Flightography write. False until verification is complete; declared attendance never self-attests to the record."
    },
    "patron_of_record_name": {
      "type": "string",
      "description": "Sponsor attribution label, shown as 'Patron of Record'. Visibility only; confers zero selection influence. Firewall-enforced: never read by discovery, ranking, or scoring."
    },
    "notes": {
      "type": "string",
      "description": "Facilitator teardown notes and competitive spec observations against the official show app"
    }
  },
  "required": [
    "conference_name",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": {
            "$ne": "draft"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.facilitator_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.facilitator_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}