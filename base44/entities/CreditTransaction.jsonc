{
  "name": "CreditTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User involved in transaction"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "earn",
        "spend",
        "escrow_lock",
        "escrow_release",
        "escrow_refund",
        "decay",
        "burn",
        "grant",
        "bonus"
      ],
      "description": "Type of credit movement"
    },
    "amount": {
      "type": "number",
      "description": "XC amount (positive for earn/release, negative for spend/lock)"
    },
    "balance_after": {
      "type": "number",
      "description": "User's balance after this transaction"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "service_exchange",
        "service_delivery",
        "platform_grant",
        "decay",
        "manual"
      ],
      "description": "What triggered this transaction"
    },
    "reference_id": {
      "type": "string",
      "description": "ID of related exchange, delivery, etc."
    },
    "counterparty_email": {
      "type": "string",
      "description": "Other party in the transaction (if applicable)"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "reversed"
      ],
      "default": "completed"
    }
  },
  "required": [
    "user_email",
    "transaction_type",
    "amount"
  ]
}