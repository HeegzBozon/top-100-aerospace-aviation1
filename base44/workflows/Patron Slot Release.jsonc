{
  "name": "Patron Slot Release",
  "description": "Every morning, lifts a hold on any slot whose ad close has passed and that no deal is attached to, returning it to the card.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "patron_slot_release",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "release_slots": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "patronSlotRelease",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Release stale holds",
            "description": "Past ad close, no deal attached"
          }
        }
      }
    ]
  }
}