{
  "name": "Patron Cadence",
  "description": "Every morning, names every live Patron deal whose next action date has passed and tells the desk who owes it.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "patron_cadence",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_cadence": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "patronCadence",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Find deals past due",
            "description": "Grouped by the seat that owes them"
          }
        }
      }
    ]
  }
}